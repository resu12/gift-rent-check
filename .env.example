# Copy to .env and add your token locally. Existing environment values win.
# Authorization uses the raw token; do not add "Bearer ".
MARKETAPP_API_TOKEN=
MARKETAPP_DB_PATH=data/marketapp.sqlite3

# Wallet used by discover-wallet and compared with observed listing owners.
MARKETAPP_OWNER_ADDRESS=

# Optional private Telegram deployment (a human user ID, not the bot's ID).
# Used by scripts/configure-serverless.py; deployment app IDs are explicit CLI flags.
TELEGRAM_OWNER_USER_ID=

# Default collection budgets (per invocation unless otherwise indicated).
MARKETAPP_PAGE_SIZE=10
MARKETAPP_MAX_PAGES=2
MARKETAPP_MAX_COLLECTIONS=3
MARKETAPP_MAX_ATTEMPTS=25
MARKETAPP_RUN_SECONDS=300
MARKETAPP_REQUESTS_PER_SECOND=1
MARKETAPP_TIMEOUT=30
MARKETAPP_RETRY_ATTEMPTS=4
MARKETAPP_SORT_BY=recently_touch
MARKETAPP_ORDER_BY=new_to_old

# Main dashboard: safety caps across automatically continued batches.
# Each start/resume gets a fresh invocation cap; the rolling 24h cap persists
# across jobs and restarts in the dashboard queue database (not account-wide).
MARKETAPP_DASHBOARD_MAX_ATTEMPTS=100
MARKETAPP_DASHBOARD_DAILY_MAX_ATTEMPTS=500
MARKETAPP_DASHBOARD_RUN_SECONDS=300
# Dashboard Marketapp pacing is capped at 1 request/second, even if the CLI
# request-rate setting above is higher. These are local caps, not provider quotas.

# Optional TON Center key. Without a key, keep the default one request/second.
TONCENTER_API_KEY=

# Separate TON discovery budgets (per invocation; pages per enumeration stream).
TON_DISCOVERY_PAGE_SIZE=100
TON_DISCOVERY_BATCH_SIZE=100
TON_DISCOVERY_MAX_PAGES=10
TON_DISCOVERY_MAX_ATTEMPTS=100
TON_DISCOVERY_RUN_SECONDS=300
TON_DISCOVERY_REQUESTS_PER_SECOND=1
TON_DISCOVERY_TIMEOUT=30
TON_DISCOVERY_RETRY_ATTEMPTS=4
