# Public frontend build settings only. Never put API keys or tokens here.
# Copy to frontend/.env.local and replace the example before a Telegram build.
# Leave unset for local development/CI with wallet connections disabled.
# VITE_TONCONNECT_APP_URL=https://appYOUR_APP_ID.tgcloud.ai
# VITE_TELEGRAM_RETURN_URL=https://t.me/YOUR_BOT?startapp
