      "expected": {"mode": "full", "scan_since": 100000, "full_scan_at": 1000000}
    },
    {
      "name": "unknown_policy_version_is_not_reused",
      "now": 1000000, "requested_since": 100000,
      "previous": {"version": 2, "complete": true, "ordered": true, "coverage_since": 100000, "checked_through": 900000, "full_scan_at": 800000},
      "expected": {"mode": "full", "scan_since": 100000, "full_scan_at": 1000000}
    },
    {
      "name": "future_head_timestamp_is_not_reused",
      "now": 1000000, "requested_since": 100000,
      "previous": {"version": 1, "complete": true, "ordered": true, "coverage_since": 100000, "checked_through": 1000001, "full_scan_at": 800000},
      "expected": {"mode": "full", "scan_since": 100000, "full_scan_at": 1000000}
    },
    {
      "name": "full_recheck_cannot_be_newer_than_checked_head",
      "now": 1000000, "requested_since": 100000,
      "previous": {"version": 1, "complete": true, "ordered": true, "coverage_since": 100000, "checked_through": 900000, "full_scan_at": 900001},
      "expected": {"mode": "full", "scan_since": 100000, "full_scan_at": 1000000}
    },
    {
      "name": "nonpositive_checked_timestamp_is_invalid",
      "now": 1000000, "requested_since": 100000,
      "previous": {"version": 1, "complete": true, "ordered": true, "coverage_since": 100000, "checked_through": 0, "full_scan_at": 800000},
      "expected": {"mode": "full", "scan_since": 100000, "full_scan_at": 1000000}
    },
    {
      "name": "noninteger_checked_timestamp_is_invalid",
      "now": 1000000, "requested_since": 100000,
      "previous": {"version": 1, "complete": true, "ordered": true, "coverage_since": 100000, "checked_through": 900000.5, "full_scan_at": 800000},
      "expected": {"mode": "full", "scan_since": 100000, "full_scan_at": 1000000}
    },
    {
      "name": "string_timestamp_is_not_coerced",
      "now": 1000000, "requested_since": 100000,
      "previous": {"version": 1, "complete": true, "ordered": true, "coverage_since": 100000, "checked_through": "900000", "full_scan_at": 800000},
      "expected": {"mode": "full", "scan_since": 100000, "full_scan_at": 1000000}
    }
  ]
}
