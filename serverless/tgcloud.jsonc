{
  "$schema": "./node_modules/@tgcloud/cli/schema/tgcloud.json",
  "static": {
    "source": "dist",
    "spa": true,
    "immutable": ["/assets/*"],
    "headers": [
      { "path": "/*", "set": { "Referrer-Policy": "no-referrer" } },
      { "path": "/tonconnect-manifest.json", "set": { "Access-Control-Allow-Origin": "*" } },
      { "path": "/wallet-icon.png", "set": { "Access-Control-Allow-Origin": "*" } }
    ]
  }
}
